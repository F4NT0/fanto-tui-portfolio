---
import { applyTheme } from '../config/themeConfig';
---

<div
  class="max-w-6xl mx-auto w-full border border-[var(--border-active)] bg-[var(--bg-main)] shadow-2xl relative transition-all duration-200"
>
  <header
    class="bg-[var(--status-bar-bg)] border-b border-[var(--border-color)] px-3 py-2 flex flex-wrap items-center justify-between gap-2 select-none"
  >
    <div class="flex items-center gap-3">
      <div
        class="text-xs font-mono font-bold text-[var(--fg-bright)] flex items-center gap-1.5"
      >
        <span class="text-[var(--fg-dim)]">fanto@matrix:</span>
        <span id="current-path" class="text-[var(--accent)] font-mono"
          >~/portfolio</span
        >
        <span
          class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--border-color)] text-[var(--fg-dim)] font-mono"
          >main*</span
        >
      </div>
    </div>

    <div
      class="flex items-center gap-1 bg-[var(--bg-card)] border border-[var(--border-color)] p-0.5 rounded-none text-xs font-mono"
    >
      <button
        id="tab-cli"
        class="hidden md:inline-block px-3 py-1 font-bold text-[var(--fg-dim)] hover:text-[var(--fg-bright)] cursor-pointer transition-colors"
      >
        >_ CLI Mode
      </button>
      <button
        id="tab-gui"
        class="px-3 py-1 font-bold text-[var(--fg-bright)] bg-[var(--border-color)] border-b-2 border-[var(--accent)] cursor-pointer transition-colors"
      >
        [#] TUI Portfólio
      </button>
    </div>

    <div class="flex items-center gap-2 text-xs font-mono">
      <button
        id="lang-toggle-btn"
        title="Toggle Language / Alternar Idioma"
        class="px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--fg-bright)] cursor-pointer font-bold"
      >
        <span id="lang-text">🇧🇷</span>
      </button>

      <button
        id="trigger-matrix-btn"
        title="Trigger Matrix Rain"
        class="px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--accent)] font-bold cursor-pointer"
      >
        ⚡ Matrix
      </button>
    </div>
  </header>

  <main class="p-4 md:p-6 min-h-[650px] flex flex-col justify-between">
    <slot />
  </main>

  <footer
    class="bg-[var(--status-bar-bg)] border-t border-[var(--border-color)] px-4 py-1.5 text-[11px] font-mono text-[var(--fg-dim)] flex flex-wrap items-center justify-between gap-2 select-none"
  >
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-emerald-400 font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span id="footer-status">STATUS 200 OK</span>
      </span>
      <span class="hidden sm:inline">UTF-8</span>
      <span class="hidden md:inline"
        ><span id="footer-mode">MODE:</span> <span id="mode-status-text">TUI</span></span
      >
    </div>

    <div class="flex items-center gap-4">
      <span id="live-clock" class="text-[var(--fg-bright)] font-mono"
        >00:00:00 UTC</span
      >
      <span class="text-[var(--accent)] font-bold">TUI_ENGINE v5.0</span>
    </div>
  </footer>
</div>

<script>
  import { applyTheme } from '../config/themeConfig';
  import { getCurrentLanguage, setLanguage, getTranslations, type Language } from '../i18n';

  document.addEventListener("DOMContentLoaded", () => {
    const isMobile =
      window.innerWidth < 768 ||
      /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(
        navigator.userAgent,
      );

    function updateClock() {
      const clockEl = document.getElementById("live-clock");
      if (clockEl) {
        const now = new Date();
        clockEl.textContent = now.toTimeString().split(" ")[0] + " LOCAL";
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Apply monochrome theme by default
    applyTheme("mono");

    // Language toggle functionality
    const langToggleBtn = document.getElementById("lang-toggle-btn");
    const langText = document.getElementById("lang-text");
    
    function updateLanguageUI(lang: Language) {
      const t = getTranslations(lang);
      if (langText) {
        langText.textContent = lang === 'pt' ? '🇧🇷' : '🇺🇸';
      }
      
      // Update translatable elements
      const tabCli = document.getElementById("tab-cli");
      const tabGui = document.getElementById("tab-gui");
      if (tabCli) tabCli.textContent = t.tabs.cli;
      if (tabGui) tabGui.textContent = t.tabs.gui;
      
      const modeStatusText = document.getElementById("mode-status-text");
      const footerStatus = document.getElementById("footer-status");
      const footerMode = document.getElementById("footer-mode");
      
      if (modeStatusText) {
        modeStatusText.textContent = t.cli.mode;
      }
      if (footerStatus) footerStatus.textContent = t.footer.status;
      if (footerMode) footerMode.textContent = t.footer.mode;
      
      // Dispatch event for other components to update
      window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang, translations: t } }));
    }
    
    langToggleBtn?.addEventListener("click", () => {
      const currentLang = getCurrentLanguage();
      const newLang: Language = currentLang === 'pt' ? 'en' : 'pt';
      setLanguage(newLang);
      updateLanguageUI(newLang);
    });
    
    // Initialize language on load
    const currentLang = getCurrentLanguage();
    updateLanguageUI(currentLang);

    document
      .getElementById("trigger-matrix-btn")
      ?.addEventListener("click", () => {
        const win = window as unknown as {
          toggleMatrix?: (f?: boolean) => void;
        };
        if (win.toggleMatrix) {
          win.toggleMatrix(true);
        }
      });

    const tabCli = document.getElementById("tab-cli");
    const tabGui = document.getElementById("tab-gui");
    const cliView = document.getElementById("view-cli");
    const guiView = document.getElementById("view-gui");
    const modeStatusText = document.getElementById("mode-status-text");

    function switchMode(mode: "cli" | "gui") {
      const targetMode = isMobile ? "gui" : mode;

      if (targetMode === "cli") {
        cliView?.classList.remove("hidden");
        guiView?.classList.add("hidden");

        tabCli?.classList.add(
          "bg-[var(--border-color)]",
          "text-[var(--fg-bright)]",
          "border-b-2",
          "border-[var(--accent)]",
        );
        tabCli?.classList.remove("text-[var(--fg-dim)]");

        tabGui?.classList.remove(
          "bg-[var(--border-color)]",
          "text-[var(--fg-bright)]",
          "border-b-2",
          "border-[var(--accent)]",
        );
        tabGui?.classList.add("text-[var(--fg-dim)]");

        if (modeStatusText) {
          const t = getTranslations(getCurrentLanguage());
          modeStatusText.textContent = t.cli.mode;
        }

        const cliInput = document.getElementById(
          "cli-input",
        ) as HTMLInputElement;
        if (cliInput) setTimeout(() => cliInput.focus(), 100);
      } else {
        guiView?.classList.remove("hidden");
        cliView?.classList.add("hidden");

        tabGui?.classList.add(
          "bg-[var(--border-color)]",
          "text-[var(--fg-bright)]",
          "border-b-2",
          "border-[var(--accent)]",
        );
        tabGui?.classList.remove("text-[var(--fg-dim)]");

        tabCli?.classList.remove(
          "bg-[var(--border-color)]",
          "text-[var(--fg-bright)]",
          "border-b-2",
          "border-[var(--accent)]",
        );
        tabCli?.classList.add("text-[var(--fg-dim)]");

        if (modeStatusText) {
          const t = getTranslations(getCurrentLanguage());
          modeStatusText.textContent = t.cli.guiMode;
        }
      }
    }

    // Start in GUI mode by default
    switchMode("gui");

    tabCli?.addEventListener("click", () => switchMode("cli"));
    tabGui?.addEventListener("click", () => switchMode("gui"));

    (
      window as unknown as { switchTuiMode: (mode: "cli" | "gui") => void }
    ).switchTuiMode = switchMode;
  });
</script>
