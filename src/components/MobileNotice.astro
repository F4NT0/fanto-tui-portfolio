---
import { getCurrentLanguage, getTranslations, type Language } from "../i18n";
---

<div
  id="mobile-notice"
  class="md:hidden mb-4 border border-yellow-500/60 bg-yellow-950/30 p-3 text-xs font-mono text-yellow-300 relative rounded-none select-none transition-all"
>
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2 font-bold text-yellow-400">
      <span class="animate-pulse">⚠️</span>
      <span id="mobile-notice-title">[DISPLAY_NOTICE]: BEST VIEWED ON DESKTOP / PC</span>
    </div>
    <button
      id="dismiss-mobile-notice"
      class="text-yellow-400 hover:text-yellow-200 font-bold cursor-pointer text-xs leading-none"
    >
      [X]
    </button>
  </div>

  <p class="mt-1.5 text-yellow-200/90 text-[11px] leading-relaxed" id="mobile-notice-message">
    For the full interactive multi-window experience, we recommend viewing this
    TUI portfolio on a laptop or desktop computer.
  </p>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const notice = document.getElementById("mobile-notice");
    const dismissBtn = document.getElementById("dismiss-mobile-notice");

    if (localStorage.getItem("tui_mobile_dismissed") === "true") {
      notice?.classList.add("hidden");
    }

    dismissBtn?.addEventListener("click", () => {
      notice?.classList.add("hidden");
      localStorage.setItem("tui_mobile_dismissed", "true");
    });

    // Language update function
    function updateMobileTranslations(lang: Language) {
      const t = getTranslations(lang);
      
      const titleEl = document.getElementById("mobile-notice-title");
      const messageEl = document.getElementById("mobile-notice-message");
      
      if (titleEl) titleEl.textContent = t.mobile.title;
      if (messageEl) messageEl.textContent = t.mobile.message;
    }
    
    // Listen for language changes
    window.addEventListener('languageChange', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      updateMobileTranslations(detail.lang);
    });
    
    // Initialize with current language
    updateMobileTranslations(getCurrentLanguage());

    function checkMobileConsoleWarning() {
      const isMobile =
        window.innerWidth < 768 ||
        /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(
          navigator.userAgent,
        );
      if (isMobile) {
        console.warn(
          "%c ⚠️ [TUI PORTFOLIO NOTICE]: MOBILE VIEWPORT DETECTED %c\nFor the optimal experience and full CLI keyboard shortcuts, we recommend viewing on a Laptop/Desktop PC (width >= 768px).",
          "color: #ffb000; font-size: 13px; font-weight: bold; background: #140d04; padding: 4px 8px; border: 1px solid #ffb000; font-family: monospace;",
          "color: #00ff66; font-size: 11px; font-family: monospace; line-height: 1.5;",
        );
      }
    }

    checkMobileConsoleWarning();
    window.addEventListener("resize", checkMobileConsoleWarning);
  });
</script>
